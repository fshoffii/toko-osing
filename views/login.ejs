<%- include('partials/header') %>
<section class="auth-wrap">
  <div class="auth-card">
    <h1>Masuk ke Toko Osing</h1>
    <p class="lead">Gunakan akun sesuai peran Anda: admin, seller, atau pembeli.</p>

    <% if (errors.general) { %>
      <div class="flash flash-error"><%= errors.general %></div>
    <% } %>

    <form method="post" action="/login" class="form" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field full">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" value="<%= form.email %>" autocomplete="email" required autofocus>
        <% if (errors.email) { %><span class="error"><%= errors.email %></span><% } %>
      </div>
      <div class="field full">
        <label for="password">Kata sandi</label>
        <input type="password" id="password" name="password" autocomplete="current-password" required>
        <% if (errors.password) { %><span class="error"><%= errors.password %></span><% } %>
      </div>
      <div class="field full">
        <button type="submit" class="btn btn-block">Masuk</button>
      </div>
    </form>

    <p class="muted center">Belum punya akun pembeli? <a href="/register">Daftar di sini</a>.</p>

    <div class="demo-box">
      <h2>Akun demo</h2>
      <ul>
        <li><strong>Admin</strong> — admin@tokoosing.test / admin123</li>
        <li><strong>Seller</strong> — batik.kemiren@tokoosing.test / seller123</li>
        <li><strong>Pembeli</strong> — buyer@tokoosing.test / buyer123</li>
      </ul>
    </div>
  </div>
</section>
<%- include('partials/footer') %>
