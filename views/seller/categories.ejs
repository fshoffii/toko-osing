<%- include('../partials/header') %>
<div class="page-head">
  <div>
    <h1>Kelola Kategori</h1>
    <p class="lead">Seller dapat menambah, mengubah, dan menghapus kategori yang dipakai produk.</p>
  </div>
</div>

<% if (errors.general) { %>
  <div class="flash flash-error"><%= errors.general %></div>
<% } %>

<section class="panel">
  <div class="panel-head">
    <h2><%= editing ? 'Ubah kategori' : 'Tambah kategori' %></h2>
    <% if (editing) { %>
      <a class="btn btn-ghost btn-sm" href="/seller/categories">Batal edit</a>
    <% } %>
  </div>

  <form method="post" action="/seller/categories" class="form" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="action" value="<%= editing ? 'update' : 'create' %>">
    <% if (editing) { %>
      <input type="hidden" name="id" value="<%= Number(editing.id) %>">
    <% } %>

    <div class="field">
      <label for="nama">Nama kategori</label>
      <input type="text" id="nama" name="nama" value="<%= form.nama %>" maxlength="60" required>
      <% if (errors.nama) { %><span class="error"><%= errors.nama %></span><% } %>
    </div>
    <div class="field">
      <label for="deskripsi">Deskripsi (opsional, maks. 200)</label>
      <input type="text" id="deskripsi" name="deskripsi" value="<%= form.deskripsi %>" maxlength="200">
      <% if (errors.deskripsi) { %><span class="error"><%= errors.deskripsi %></span><% } %>
    </div>
    <div class="field full">
      <button type="submit" class="btn"><%= editing ? 'Simpan perubahan' : 'Tambah kategori' %></button>
    </div>
  </form>
</section>

<section class="panel">
  <div class="panel-head">
    <h2>Daftar kategori</h2>
    <span class="muted"><%= categories.length %> kategori</span>
  </div>
  <div class="table-wrap">
    <table>
      <thead>
        <tr><th>Kategori</th><th>Deskripsi</th><th>Produk</th><th>Total stok</th><th>Aksi</th></tr>
      </thead>
      <tbody>
        <% categories.forEach((category) => { %>
          <tr>
            <td><strong><%= category.nama %></strong><br><span class="muted"><%= category.slug %></span></td>
            <td><%= category.deskripsi || '—' %></td>
            <td><%= Number(category.jumlah_produk) %></td>
            <td><%= Number(category.total_stok) %></td>
            <td class="actions">
              <a class="btn btn-ghost btn-sm" href="/seller/categories?edit=<%= Number(category.id) %>">Ubah</a>
              <form method="post" action="/seller/categories" onsubmit="return confirm('Hapus kategori ini?');">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="action" value="delete">
                <input type="hidden" name="id" value="<%= Number(category.id) %>">
                <button type="submit" class="btn btn-danger btn-sm">Hapus</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>
<%- include('../partials/footer') %>
