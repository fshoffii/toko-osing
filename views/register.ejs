<%- include('partials/header') %>
<section class="auth-wrap">
  <div class="auth-card">
    <h1>Daftar Akun Pembeli</h1>
    <p class="lead">Pembeli dapat melihat katalog dan menghubungi seller lewat WhatsApp.</p>

    <form method="post" action="/register" class="form" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field full">
        <label for="nama">Nama lengkap</label>
        <input type="text" id="nama" name="nama" value="<%= form.nama %>" maxlength="100" required>
        <% if (errors.nama) { %><span class="error"><%= errors.nama %></span><% } %>
      </div>
      <div class="field">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" value="<%= form.email %>" autocomplete="email" required>
        <% if (errors.email) { %><span class="error"><%= errors.email %></span><% } %>
      </div>
      <div class="field">
        <label for="whatsapp">WhatsApp (opsional)</label>
        <input type="text" id="whatsapp" name="whatsapp" value="<%= form.whatsapp %>" placeholder="08xxxxxxxxxx" inputmode="numeric">
        <% if (errors.whatsapp) { %><span class="error"><%= errors.whatsapp %></span><% } %>
      </div>
      <div class="field">
        <label for="password">Kata sandi</label>
        <input type="password" id="password" name="password" minlength="6" autocomplete="new-password" required>
        <% if (errors.password) { %><span class="error"><%= errors.password %></span><% } %>
      </div>
      <div class="field">
        <label for="password_confirm">Ulangi kata sandi</label>
        <input type="password" id="password_confirm" name="password_confirm" minlength="6" autocomplete="new-password" required>
        <% if (errors.password_confirm) { %><span class="error"><%= errors.password_confirm %></span><% } %>
      </div>
      <div class="field full">
        <button type="submit" class="btn btn-block">Daftar sebagai pembeli</button>
      </div>
    </form>

    <p class="muted center">Sudah punya akun? <a href="/login">Masuk</a>.</p>
  </div>
</section>
<%- include('partials/footer') %>
